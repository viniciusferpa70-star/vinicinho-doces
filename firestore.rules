rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null && request.auth.token.email == 'viniciusferpa70@gmail.com';
    }
    match /businesses/vinicinho-doces {
      allow read: if owner();
      allow create: if owner() && request.resource.data.syncVersion == 2
        && request.resource.data.revision == 1 && request.resource.data.updatedAt == request.time;
      allow update: if owner() && request.resource.data.syncVersion == 2
        && request.resource.data.revision == resource.data.get('revision', 0) + 1
        && request.resource.data.updatedAt == request.time;
      match /musicTracks/{track} {
        allow read, write: if owner();
        match /musicChunks/{chunk} {
          allow read, write: if owner();
        }
      }
      match /musicPlaylists/{playlist} {
        allow read, write: if owner();
      }
    }

    match /storefront/catalog {
      allow read: if true;
      allow write: if owner() && request.resource.data.syncVersion == 2
        && request.resource.data.revision == getAfter(/databases/$(database)/documents/businesses/vinicinho-doces).data.revision
        && getAfter(/databases/$(database)/documents/businesses/vinicinho-doces).data.updatedAt == request.time;
    }

    match /storefrontCustomers/{customerKey} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.key == customerKey
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;
      allow delete: if owner();

      match /orders/{orderId} {
        allow get, list: if true;
        allow create: if request.resource.data.customerKey == customerKey
          && request.resource.data.customerName is string
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.status == 'novo';
        allow update: if owner() || (
          request.resource.data.customerKey == resource.data.customerKey
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages','adminUnread','customerUnread','updatedAt'])
        );
        allow delete: if owner();
      }
    }

    match /{path=**}/orders/{orderId} {
      allow read: if owner();
    }
  }
}
