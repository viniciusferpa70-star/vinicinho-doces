{
  "firestore": {"rules":"firestore.rules","indexes":"firestore.indexes.json"},
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "README.md",
      "firestore.*",
      "output/**",
      "tmp/**",
      "tests/**",
      "**/.*",
      "**/.*/**",
      "**/*.log",
      "**/node_modules/**"
    ],
    "headers": [{"source":"**/*.html","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},{"source":"/","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]}],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
