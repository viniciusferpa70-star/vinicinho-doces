{
  "firestore": {"rules":"firestore.rules","indexes":"firestore.indexes.json"},
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "README.md",
      "firestore.*",
      "output/**",
      "tmp/**",
      "**/.*",
      "**/.*/**",
      "**/*.log",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
